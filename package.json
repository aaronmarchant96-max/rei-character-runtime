{
  "name": "rei-character-runtime",
  "version": "0.1.0",
  "private": false,
  "description": "Evidence-driven runtime for contextual, voiced game characters.",
  "type": "module",
  "scripts": {
    "ollama:serve": "OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NO_CLOUD=1 OLLAMA_MODELS=$PWD/.local/ollama-models .local/ollama/bin/ollama serve",
    "demo": "node src/cli.js",
    "voice": "node src/cli.js --speak",
    "voice:neural": "node src/cli.js --speak --backend=piper",
    "npc:local": "node src/cli.js --dialogue=ollama --speak --backend=piper",
    "target:listen": "node scripts/listen-oblivion-target.mjs",
    "bridge:fixture": "node scripts/write-bridge-response.mjs",
    "bridge:build": "bash scripts/build-xobse-plugin.sh",
    "test": "node --test",
    "check": "node --check src/*.js && node --check scripts/listen-oblivion-target.mjs && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
